]
vocab = {i: name for i, name in enumerate(flower_names)}
vocab_size = len(vocab)
print("Vocabulary size:", vocab_size)

class FeatureToTransformer(nn.Module):
    def __init__(self, vocab_size, d_model=256, nhead=8):
        super().__init__()
        self.resnet_projection = nn.Linear(2048, d_model)
        self.embedding = nn.Embedding(vocab_size, d_model)
        decoder_layer = nn.TransformerDecoderLayer(
            d_model=d_model,
            nhead=nhead,
            batch_first=True
        )
        self.transformer_decoder = nn.TransformerDecoder(
            decoder_layer,
            num_layers=3
        )
        self.fc_out = nn.Linear(d_model, vocab_size)
    def forward(self, resnet_features, target_ids):
        visual_memory = self.resnet_projection(resnet_features).unsqueeze(1)
        tgt_embeddings = self.embedding(target_ids)
        output = self.transformer_decoder(tgt_embeddings, visual_memory)
        return self.fc_out(output)
model = FeatureToTransformer(vocab_size).to(DEVICE)
print("Transformer Model Ready")
resnet50 = models.resnet50(weights="IMAGENET1K_V1")
resnet_backbone = nn.Sequential(
    *list(resnet50.children())[:-2]
).to(DEVICE)
resnet_backbone.eval()
print("ResNet Feature Extractor Ready")

optimizer = optim.Adam(
    model.parameters(),
    lr=0.001
)
criterion = nn.CrossEntropyLoss()
