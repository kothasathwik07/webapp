import tensorflow as tf
import keras
import keras_hub
import numpy as np
from sklearn.metrics import accuracy_score, f1_score

preset = "t5_small_multi"
backbone = keras_hub.models.T5Backbone.from_preset(preset)

(x_train, y_train), (x_test, y_test) = keras.datasets.imdb.load_data(num_words=20000)
word_index = keras.datasets.imdb.get_word_index()
reverse_word_index = dict((v, k) for k, v in word_index.items())

def decode_review(text):
    return " ".join([reverse_word_index.get(i - 3, "?") for i in text])

train_texts = [decode_review(x) for x in x_train[:2000]]
test_texts  = [decode_review(x) for x in x_test[:500]]
train_labels = y_train[:2000]
test_labels  = y_test[:500]

max_len = 128
vocab_size = 20000

vectorizer = keras.layers.TextVectorization(
    max_tokens=vocab_size,
    output_mode="int",
    output_sequence_length=max_len
)

vectorizer.adapt(train_texts)

train_token_ids = vectorizer(np.array(train_texts))
test_token_ids  = vectorizer(np.array(test_texts))

train_padding_mask = tf.cast(train_token_ids != 0, tf.int32)
test_padding_mask  = tf.cast(test_token_ids != 0, tf.int32)

train_decoder_ids = tf.zeros_like(train_token_ids)
train_decoder_mask = tf.zeros_like(train_padding_mask)

test_decoder_ids = tf.zeros_like(test_token_ids)
test_decoder_mask = tf.zeros_like(test_padding_mask)

encoder_token_ids = keras.Input(shape=(max_len,), dtype="int32")
encoder_padding_mask = keras.Input(shape=(max_len,), dtype="int32")
decoder_token_ids = keras.Input(shape=(max_len,), dtype="int32")
decoder_padding_mask = keras.Input(shape=(max_len,), dtype="int32")
outputs = backbone(
    {
        "encoder_token_ids": encoder_token_ids,
        "encoder_padding_mask": encoder_padding_mask,
        "decoder_token_ids": decoder_token_ids,
        "decoder_padding_mask": decoder_padding_mask,
    }
)
encoder_output = outputs["encoder_sequence_output"]
x = keras.layers.GlobalAveragePooling1D()(encoder_output)
x = keras.layers.Dense(128, activation="relu")(x)
x = keras.layers.Dropout(0.3)(x)
final_output = keras.layers.Dense(1, activation="sigmoid")(x)

model = keras.Model(
    inputs=[
        encoder_token_ids,
        encoder_padding_mask,
        decoder_token_ids,
        decoder_padding_mask,
    ],
    outputs=final_output,
)

model.compile(
    optimizer=keras.optimizers.Adam(1e-4),
    loss="binary_crossentropy",
    metrics=["accuracy"]
)
model.fit(
    [
        train_token_ids,
        train_padding_mask,
        train_decoder_ids,
        train_decoder_mask,
    ],
    train_labels,
    validation_split=0.2,
    batch_size=8,
    epochs=3
)

pred_probs = model.predict(
    [   test_token_ids,
        test_padding_mask,
        test_decoder_ids,
        test_decoder_mask,
    ]
)
predictions = (pred_probs > 0.5).astype(int)
print("Accuracy:", accuracy_score(test_labels, predictions))
print("F1 Score:", f1_score(test_labels, predictions))


