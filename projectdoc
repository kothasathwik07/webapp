import os
import re
import pickle
import numpy as np
import pandas as pd
import kagglehub

import tensorflow as tf
from tensorflow import keras
from tensorflow.keras import layers
from tensorflow.keras.applications import ResNet50
from tensorflow.keras.applications.resnet50 import preprocess_input
from tensorflow.keras.preprocessing.image import load_img, img_to_array
from tensorflow.keras.preprocessing.text import Tokenizer
from tensorflow.keras.preprocessing.sequence import pad_sequences

from nltk.translate.bleu_score import corpus_bleu

path = kagglehub.dataset_download("adityajn105/flickr8k")
print("Dataset path:", path)

class CFG:
    BASE_DIR = path
    IMAGE_DIR = os.path.join(BASE_DIR, "Images")
    CAPTION_FILE = os.path.join(BASE_DIR, "captions.txt")
    SAVE_DIR = "/kaggle/working"

    MAX_IMAGES = 1000
    CAPTIONS_PER_IMAGE = 2

    IMG_SIZE = (224, 224)
    FEAT_DIM = 2048

    MAX_VOCAB = 3000
    MAX_LEN = 25

    EMBED_DIM = 128
    LSTM_UNITS = 256
    DENSE_DIM = 256
    DROPOUT = 0.3

    BATCH_SIZE = 128
    EPOCHS = 5
    LR = 3e-4
    TRAIN_SPLIT = 0.9
    FEAT_BATCH = 64

def load_captions(path):
    df = pd.read_csv(path)
    captions = {}
    for _, row in df.iterrows():
        img = row["image"]
        cap = row["caption"]
        if len(captions) >= CFG.MAX_IMAGES and img not in captions:
            continue
        cap = re.sub(r"[^a-z\s]", "", cap.lower())
        cap = "startseq " + cap + " endseq"
        lst = captions.setdefault(img, [])
        if len(lst) < CFG.CAPTIONS_PER_IMAGE:
            lst.append(cap)
    return captions
captions = load_captions(CFG.CAPTION_FILE)

all_caps = [c for caps in captions.values() for c in caps]
tokenizer = Tokenizer(num_words=CFG.MAX_VOCAB, oov_token="<unk>")
tokenizer.fit_on_texts(all_caps)
VOCAB_SIZE = len(tokenizer.word_index) + 1
MAX_LEN = CFG.MAX_LEN

def build_resnet():
    base = ResNet50(weights="imagenet", include_top=False,
                    input_shape=(*CFG.IMG_SIZE, 3))
    base.trainable = False
    x = layers.GlobalAveragePooling2D()(base.output)
    return keras.Model(base.input, x)
resnet = build_resnet()

def extract_features(image_dir, img_list):
    features = {}
    for i in range(0, len(img_list), CFG.FEAT_BATCH):
        batch_files = img_list[i:i+CFG.FEAT_BATCH]
        imgs, names = [], []
        for f in batch_files:
            try:
                img = load_img(os.path.join(image_dir, f),
                               target_size=CFG.IMG_SIZE)
                imgs.append(img_to_array(img))
                names.append(f)
            except:
                continue
        batch = preprocess_input(np.array(imgs))
        feats = resnet.predict(batch, verbose=0)
        for name, feat in zip(names, feats):
            features[name] = feat
    return features
img_features = extract_features(CFG.IMAGE_DIR, list(captions.keys()))

imgs = list(img_features.keys())
split = int(CFG.TRAIN_SPLIT * len(imgs))

train_imgs = set(imgs[:split])
test_imgs = set(imgs[split:])

def build_sequences(img_set):
    X1, X2, Y = [], [], []
    for img in img_set:
        feat = img_features[img]
        for cap in captions[img]:
            seq = tokenizer.texts_to_sequences([cap])[0]
            for i in range(1, len(seq)):
                X1.append(feat)
                X2.append(pad_sequences([seq[:i]], maxlen=MAX_LEN)[0])
                Y.append(seq[i])
    return np.array(X1), np.array(X2), np.array(Y)
X1, X2, Y = build_sequences(train_imgs)

def build_model():
    img_in = layers.Input(shape=(CFG.FEAT_DIM,))
    img = layers.Dense(CFG.EMBED_DIM, activation="relu")(img_in)
    img = layers.RepeatVector(MAX_LEN)(img)

    cap_in = layers.Input(shape=(MAX_LEN,))
    cap = layers.Embedding(VOCAB_SIZE, CFG.EMBED_DIM, mask_zero=True)(cap_in)

    x = layers.Add()([img, cap])
    x = layers.LSTM(CFG.LSTM_UNITS)(x)
    x = layers.Dense(CFG.DENSE_DIM, activation="relu")(x)
    out = layers.Dense(VOCAB_SIZE, activation="softmax")(x)

    model = keras.Model([img_in, cap_in], out)
    model.compile(
        optimizer=keras.optimizers.Adam(CFG.LR),
        loss="sparse_categorical_crossentropy",
        metrics=["accuracy"]
    )
    return model
model = build_model()

train_ds = tf.data.Dataset.from_tensor_slices(((X1, X2), Y)) \
            .shuffle(5000).batch(CFG.BATCH_SIZE)

model.fit(train_ds, epochs=CFG.EPOCHS)

def generate_caption(model, feat):
    caption = ["startseq"]
    for _ in range(MAX_LEN):
        seq = tokenizer.texts_to_sequences([" ".join(caption)])[0]
        seq = pad_sequences([seq], maxlen=MAX_LEN)
        pred = model.predict([feat.reshape(1, -1), seq], verbose=0)
        word = tokenizer.index_word.get(np.argmax(pred))
        if word == "endseq" or word is None:
            break
        caption.append(word)
    return " ".join(caption[1:])

def evaluate(n=50):
    actual, predicted = [], []
    for img in list(img_features.keys())[:n]:
        refs = [c.split()[1:-1] for c in captions[img]]
        pred = generate_caption(model, img_features[img]).split()
        actual.append(refs)
        predicted.append(pred)
    print("BLEU-1:", corpus_bleu(actual, predicted, weights=(1,0,0,0)))

import matplotlib.pyplot as plt
def show_image(img_name, caption=None):
    img_path = os.path.join(CFG.IMAGE_DIR, img_name)
    img = load_img(img_path, target_size=CFG.IMG_SIZE)
    plt.imshow(img)
    plt.axis("off")
    if caption:
        plt.title(caption)
    plt.show()

img_name = list(img_features.keys())[0]
caption = generate_caption(model, img_features[img_name])
show_image(img_name, caption)

evaluate(25)

os.makedirs(CFG.SAVE_DIR, exist_ok=True)
model.save(os.path.join(CFG.SAVE_DIR, "model.h5"))
with open(os.path.join(CFG.SAVE_DIR, "tokenizer.pkl"), "wb") as f:
    pickle.dump(tokenizer, f)


