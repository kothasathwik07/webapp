            feature_map = resnet_backbone(imgs)
            features = feature_map.mean([2,3])
        optimizer.zero_grad()
        outputs = model(
            features,
            labels.unsqueeze(1)
        )
        loss = criterion(
            outputs.view(-1, vocab_size),
            labels
        )
        loss.backward()
        optimizer.step()
        break
    print(f"Epoch {epoch+1} Loss: {loss.item():.4f}")

